APP_NAME=Viet Anh Staff Assistant
ENVIRONMENT=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
# Supabase anon/publishable key; public and returned only by /api/auth/config for Google OAuth in the browser.
SUPABASE_ANON_KEY=
TOP_K=20
MIN_RELEVANCE_SCORE=0.22
EMBEDDING_PROVIDER=mock
# RETRIEVAL_MODE: vector (tìm bằng embeddings) | lexical (tìm theo từ khoá BM25, không cần embeddings)
RETRIEVAL_MODE=vector
# LLM_PROVIDER: mock | gemini | openrouter | openai_compatible (endpoint kiểu OpenAI tự dựng, vd. proxy Claude)
LLM_PROVIDER=openrouter
# Chỉ dùng khi LLM_PROVIDER=openai_compatible. KHÔNG commit giá trị thật; địa chỉ endpoint cũng không công khai.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=cc/claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ADMIN_TOKEN=
ANTHROPIC_API_KEY=
VAULT_PATH=
# Chi dat tren SERVER (noi co drive-sync): ".drive-sync-ready". VaultWatcher se cho
# drive-sync keo xong vault lan dau roi moi theo doi - tranh chay Ingest Agent hang
# loat tren du lieu cu. Chay local khong co drive-sync thi de trong.
VAULT_READY_MARKER=
# Duong dan toi binary "claude" native tren may nay - chi can tren Windows (npm cli
# la file .CMD, bi Claude Agent SDK tu choi chay vi ly do bao mat). Tren Linux server
# de trong, SDK tu tim trong PATH.
CLAUDE_CLI_PATH=
# Danh sach domain cong ty bat buoc de gioi han dang nhap (Google + mat khau),
# cach nhau boi dau phay. De trong = backend tu choi dang nhap (fail closed).
ALLOWED_EMAIL_DOMAINS=
# Đăng nhập 1 lần từ Major OS: khoá bí mật dùng chung (>= 32 ký tự ngẫu nhiên) mà backend
# Major OS dùng để ký mã HS256. Để trống = tắt. Xem docs/Huong_dan_SSO_Major_OS.md
OS_SSO_SECRET=

# --- drive-sync: dong bo /data/vault 2 chieu voi 1 thu muc goc tren Google Drive ---
# Dung 1 tai khoan Google Drive rieng "so huu" toan bo thu muc vault (khong phai
# tai khoan ca nhan ai), roi tu tai khoan do share tung thu muc con ra cho dung
# nguoi/nhom that voi quyen phu hop. Cach lay DRIVE_RCLONE_CONFIG_B64:
#   1. Cai rclone tren may CA NHAN (khong phai server): https://rclone.org/downloads/
#   2. Chay `rclone config`, tao 1 remote ten "gdrive" (hoac ten khac, khop voi
#      DRIVE_REMOTE_NAME ben duoi), chon Google Drive, dang nhap dung tai khoan
#      "so huu" vault noi tren qua trinh duyet khi rclone mo len.
#   3. Chay `cat ~/.config/rclone/rclone.conf | base64 -w0` (Linux/Mac) hoac
#      tuong duong tren Windows, dan ket qua vao DRIVE_RCLONE_CONFIG_B64.
DRIVE_RCLONE_CONFIG_B64=
DRIVE_REMOTE_NAME=gdrive
# ID hoac duong dan thu muc goc cua vault tren Drive (vd "VietAnhVault" neu nam
# thang trong My Drive cua tai khoan so huu).
DRIVE_FOLDER_PATH=

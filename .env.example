APP_NAME=Viet Anh Staff Assistant
ENVIRONMENT=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=
TOP_K=20
MIN_RELEVANCE_SCORE=0.22
EMBEDDING_PROVIDER=mock
LLM_PROVIDER=openrouter
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ADMIN_TOKEN=
ANTHROPIC_API_KEY=
VAULT_PATH=
# Duong dan toi binary "claude" native tren may nay - chi can tren Windows (npm cli
# la file .CMD, bi Claude Agent SDK tu choi chay vi ly do bao mat). Tren Linux server
# de trong, SDK tu tim trong PATH.
CLAUDE_CLI_PATH=
# Danh sach domain email cong ty duoc phep dang ky, cach nhau boi dau phay
# (vd truongvietanh.com,mamnon-vietanh.com). De trong = khong gioi han.
ALLOWED_EMAIL_DOMAINS=

# --- seaf-sync: dong bo /data/vault voi 1 library tren Seafile server ---
# Xem ../seafile-server/ de deploy server. Tao 1 "service account" rieng tren
# Seafile (khong phai tai khoan ca nhan), cap quyen read+write vao dung library
# vault, roi dien 4 bien duoi day.
SEAFILE_SERVER_URL=
SEAFILE_SYNC_EMAIL=
SEAFILE_SYNC_PASSWORD=
SEAFILE_LIBRARY_ID=
